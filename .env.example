# Copy to .env and fill in. .env is gitignored; never commit real values.

# The "+asyncpg" driver is required -- psycopg2 is sync and will not work.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/job_application

# Sign the JWTs. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Log every statement. Useful when debugging a query, noisy otherwise.
DB_ECHO=false
